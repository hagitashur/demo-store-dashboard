# דוגמה להגדרות של סקריפט הסנכרון (scripts/sync_airtable.py).
#
# איך משתמשים:
#   1. מעתיקים את הקובץ הזה לקובץ חדש בשם  .env  (בלי המילה example).
#   2. ממלאים את הערכים האמיתיים בקובץ .env בלבד.
#   3. הקובץ .env חסום ב-.gitignore ולא עולה לריפו. את הקובץ הזה (.env.example) לא ממלאים בערכים אמיתיים.

# אסימון גישה אישי (Personal Access Token) מ-Airtable:
# הרשאה אחת בלבד, data.records:read, ורק לבסיס של הפרויקט.
AIRTABLE_TOKEN=

# מזהה הבסיס. מתחיל ב-app ונמצא בכתובת של הבסיס בדפדפן.
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# שמות הטבלאות (רק אם שינית אותם):
# AIRTABLE_PRODUCTS_TABLE=מוצרים
# AIRTABLE_SALES_TABLE=מכירות
